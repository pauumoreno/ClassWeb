    }
<#
    string parametrosHeredados = "";
    string argumentosSuper = "";

    Clase ancestro = clase.ClasePadre;

    while (ancestro != null)
    {
        string parametrosNivel = "";
        string argumentosNivel = "";

        foreach (Atributo atributoHeredado in ancestro.Atributo)
        {
            string nombreHeredado =
                atributoHeredado.Nombre.Split(':')[0].Trim();

            string tipoHeredado =
                atributoHeredado.TipoDato.ToString();

            if (tipoHeredado == "Int32")
                tipoHeredado = "int";
            else if (tipoHeredado == "Double")
                tipoHeredado = "double";
            else if (tipoHeredado == "Boolean")
                tipoHeredado = "boolean";
            else if (tipoHeredado == "Byte") tipoHeredado = "byte";
            else if (tipoHeredado == "Char") tipoHeredado = "char";
            else if (tipoHeredado == "Int16") tipoHeredado = "short";
            else if (tipoHeredado == "Int64") tipoHeredado = "long";
            else if (tipoHeredado == "DateTime")
                tipoHeredado = "Date";

            if (parametrosNivel != "")
            {
                parametrosNivel += ", ";
                argumentosNivel += ", ";
            }

            parametrosNivel += tipoHeredado + " " + nombreHeredado;
            argumentosNivel += nombreHeredado;
        }

        if (parametrosNivel != "")
        {
            parametrosHeredados =
                parametrosNivel +
                (parametrosHeredados == "" ? "" : ", " + parametrosHeredados);

            argumentosSuper =
                argumentosNivel +
                (argumentosSuper == "" ? "" : ", " + argumentosSuper);
        }

        ancestro = ancestro.ClasePadre;
    }

    string parametrosPropios = "";

    foreach (Atributo atributoPropio in clase.Atributo)
    {
        string nombrePropio =
            atributoPropio.Nombre.Split(':')[0].Trim();

        string tipoPropio = atributoPropio.TipoDato.ToString();

        if (tipoPropio == "Int32")
            tipoPropio = "int";
        else if (tipoPropio == "Double")
            tipoPropio = "double";
        else if (tipoPropio == "Boolean")
            tipoPropio = "boolean";
        else if (tipoPropio == "Byte") tipoPropio = "byte";
        else if (tipoPropio == "Char") tipoPropio = "char";
        else if (tipoPropio == "Int16") tipoPropio = "short";
        else if (tipoPropio == "Int64") tipoPropio = "long";
        else if (tipoPropio == "DateTime")
            tipoPropio = "Date";

        if (parametrosPropios != "")
            parametrosPropios += ", ";

        parametrosPropios += tipoPropio + " " + nombrePropio;
    }

    string parametrosTotales = parametrosHeredados;

    if (parametrosPropios != "")
    {
        if (parametrosTotales != "")
            parametrosTotales += ", ";

        parametrosTotales += parametrosPropios;
    }

    if (parametrosTotales != "")
    {

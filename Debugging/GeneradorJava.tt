    foreach (Atributo atributo in clase.Atributo)
    {
        string tipoJava = atributo.TipoDato.ToString();
        string nombreAtributo = atributo.Nombre.Split(':')[0].Trim();

        if (tipoJava == "Int32")
        {
            tipoJava = "int";
        }
        else if (tipoJava == "Double")
        {
            tipoJava = "double";
        }
        else if (tipoJava == "Boolean")
        {
            tipoJava = "boolean";
        }
        else if (tipoJava == "Byte") tipoJava = "byte";
        else if (tipoJava == "Char") tipoJava = "char";
        else if (tipoJava == "Int16") tipoJava = "short";
        else if (tipoJava == "Int64") tipoJava = "long";
        else if (tipoJava == "DateTime")
        {
            tipoJava = "Date";
        }
        else if (tipoJava == "String")
        {
            tipoJava = "String";
        }
#>
    private <#= tipoJava #> <#= nombreAtributo #>;
<#
    }

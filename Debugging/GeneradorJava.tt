<#var fileManager = EntityFrameworkTemplateFileManager.Create(this);

foreach (Clase clase in this.DiagramaClassWeb.Clases)
{
    fileManager.StartNewFile(clase.Nombre + ".java");
    string modificador = "";
    if (clase.Abstracta)
    {
        modificador = "abstract ";
    }
string herencia = "";
if (clase.ClasePadre != null)
{
    herencia = " extends " + clase.ClasePadre.Nombre;
}
bool usaDate = false;
Clase claseRevisada = clase;
while (claseRevisada != null)
{
    foreach (Atributo a in claseRevisada.Atributo)
    {
        if (a.TipoDato.ToString() == "DateTime") usaDate = true;
    }
    claseRevisada = claseRevisada.ClasePadre;
}
foreach (Operacion o in clase.Operacioned)
{
    if (o.TipoRetorno.ToString() == "DateTime") usaDate = true;
    foreach (Parametro p in o.Parametros)
    {
        if (p.Tipo.ToString() == "DateTime") usaDate = true;
    }
}
if (usaDate)
{

        else if (tipoRetorno == "Double")
            tipoRetorno = "double";
        else if (tipoRetorno == "Boolean")
            tipoRetorno = "boolean";
        else if (tipoRetorno == "Byte") tipoRetorno = "byte";
        else if (tipoRetorno == "Char") tipoRetorno = "char";
        else if (tipoRetorno == "Int16") tipoRetorno = "short";
        else if (tipoRetorno == "Int64") tipoRetorno = "long";
        else if (tipoRetorno == "DateTime")
            tipoRetorno = "Date";
        else if (tipoRetorno == "Void" || tipoRetorno == "Nulo")
            tipoRetorno = "void";

        string parametrosJava = "";

        foreach (Parametro p in op.Parametros)

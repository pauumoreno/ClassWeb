            else if (tipoParametro == "Int64") tipoParametro = "long";
            else if (tipoParametro == "DateTime")
                tipoParametro = "Date";

            if (parametrosJava != "")
                parametrosJava += ", ";

            parametrosJava += tipoParametro + " " + nombreParametro;
        }

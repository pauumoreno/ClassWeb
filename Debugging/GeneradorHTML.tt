fileManager.StartNewFile("MenuAplicacion.html");
#>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Gestión de Clases Web</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: white;
        }

        .menu {
            background-color: #C2D8F2;
            border: 1px solid #888;
            margin: 20px;
            padding: 20px;
        }

        h1 {
            color: #172E4D;
        }

        a {
            color: blue;
        }

        li {
            margin-bottom: 8px;
        }

        button {
            margin-top: 12px;
            padding: 5px 12px;
        }
    </style>
</head>
<body>
<div class="menu">

    <h1>Gestión de Clases Web</h1>

    <h2>Clases</h2>

    <ul>
<#
foreach (Clase claseMenu in this.DiagramaClassWeb.Clases)
{
    if (claseMenu.Abstracta ||
        string.IsNullOrWhiteSpace(claseMenu.Nombre))
    {
        continue;
    }
#>
        <li>
            <a href="./<#= claseMenu.Nombre.Trim() #>.html">
                <#= claseMenu.Nombre.Trim() #>
            </a>
        </li>
<#
}
#>
    </ul>

    <h2>Asociaciones N:M</h2>

    <ul>
<#
foreach (Clase origenMenu in this.DiagramaClassWeb.Clases)
{
    foreach (ClaseReferencesClase relacionMenu in
        ClaseReferencesClase.GetLinksToReferenciaTarget(origenMenu))
    {
        string cardOrigenMenu =
            relacionMenu.CardOrigen.ToString();

        string cardDestinoMenu =
            relacionMenu.CardDestino.ToString();

        bool muchosOrigenMenu =
            cardOrigenMenu == "Card_0_n" ||
            cardOrigenMenu == "Card_1_n" ||
            cardOrigenMenu == "Card_m_n";

        bool muchosDestinoMenu =
            cardDestinoMenu == "Card_0_n" ||
            cardDestinoMenu == "Card_1_n" ||
            cardDestinoMenu == "Card_m_n";

        if (!muchosOrigenMenu || !muchosDestinoMenu)
            continue;

        if (relacionMenu.TargetClase == null ||
            string.IsNullOrWhiteSpace(relacionMenu.Nombre))
            continue;

        bool tieneIdOrigen = false;
        Clase origenActual = origenMenu;

        while (origenActual != null && !tieneIdOrigen)
        {
            foreach (Atributo a in origenActual.Atributo)
            {
                if (a.EsId)
                {
                    tieneIdOrigen = true;
                    break;
                }
            }
            origenActual = origenActual.ClasePadre;
        }

        bool tieneIdDestino = false;
        Clase destinoActual = relacionMenu.TargetClase;

        while (destinoActual != null && !tieneIdDestino)
        {
            foreach (Atributo a in destinoActual.Atributo)
            {
                if (a.EsId)
                {
                    tieneIdDestino = true;
                    break;
                }
            }
            destinoActual = destinoActual.ClasePadre;
        }

        if (!tieneIdOrigen || !tieneIdDestino)
            continue;

        string nombreMenuRelacion = relacionMenu.Nombre;
#>
        <li>
            <a href="./<#= nombreMenuRelacion #>.html">
                <#= nombreMenuRelacion #>
            </a>
        </li>
<#
    }
}
#>
    </ul>

    <button type="button" onclick="window.close()">
        Cerrar
    </button>

</div>
</body>
</html>

<#
fileManager.Process();
#>